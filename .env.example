# Copy to .env and replace every change_me. .env is git-ignored.
# DNSE public market-data endpoint needs NO key (see docs/DNSE_API_NOTES.md).

MYSQL_HOST=127.0.0.1
# 3307 on the host: 3306 is commonly taken by another local MySQL.
MYSQL_PORT=3307
MYSQL_DATABASE=predict_stock
MYSQL_TEST_DATABASE=predict_stock_test

MYSQL_ROOT_PASSWORD=change_me_root
# Runtime user: DML only (SELECT/INSERT/UPDATE/DELETE).
MYSQL_APP_USER=predict_app
MYSQL_APP_PASSWORD=change_me_app
# Schema owner used by Alembic and tests: DDL + DML on the two databases above only.
MYSQL_MIGRATOR_USER=predict_migrator
MYSQL_MIGRATOR_PASSWORD=change_me_migrator

# Optional: path to an alternative YAML config (default: config/default.yaml)
# PREDICT_CONFIG=config/default.yaml
